---
import Base from '../../layouts/Base.astro';
import CarteVehicule from '../../components/CarteVehicule.astro';
import BoutonWhatsApp from '../../components/BoutonWhatsApp.astro';
import EntetePage from '../../components/EntetePage.astro';
import { site, getVehicules } from '../../lib/site';

const vehicules = await getVehicules();
const categories = [...new Set(vehicules.map((v) => v.data.categorie))];
// Pas de filtres inutiles si le catalogue est restreint (brief §5).
const avecFiltres = categories.length > 1 && vehicules.length > 3;
---
<Base titre="Nos véhicules" description={`Catalogue des véhicules en location chez ${site.nom} : ${categories.join(', ')}. Réservation sur WhatsApp.`}>
  <EntetePage surtitre="Notre flotte" titre="Nos véhicules" intro="Choisissez un véhicule puis envoyez-nous vos dates sur WhatsApp. La disponibilité et le tarif vous sont confirmés par notre équipe." />
  <section class="section section--catalogue">
    <div class="conteneur">
      {avecFiltres && (
        <div class="filtres" role="group" aria-label="Filtrer par catégorie">
          <button type="button" aria-pressed="true" data-cat="">Tous</button>
          {categories.map((c) => <button type="button" aria-pressed="false" data-cat={c}>{c}</button>)}
        </div>
      )}
      {vehicules.length > 0
        ? <div class="grille" id="catalogue">{vehicules.map((v, i) => <div data-cat={v.data.categorie} class="revele" style={`transition-delay:${(i % 4) * 80}ms`}><CarteVehicule vehicule={v} prioritaire={i < 2} /></div>)}</div>
        : <p>Le catalogue est en cours de mise en ligne. <BoutonWhatsApp libelle="Demander les disponibilités" source="catalogue-vide" /></p>}
      <div class="aide carte revele">
        <div><h2>Vous ne trouvez pas le véhicule idéal ?</h2><p>Dites-nous ce dont vous avez besoin : nombre de passagers, dates, usage. Nous vous proposons une solution.</p></div>
        <BoutonWhatsApp libelle="Décrire mon besoin" source="catalogue-aide" message={`Bonjour ${site.nom}, je cherche un véhicule pour :\nNombre de passagers : …\nDates : du … au …\nUsage : …`} />
      </div>
    </div>
  </section>
</Base>

{avecFiltres && (
  <script>
    const boutons = document.querySelectorAll<HTMLButtonElement>('.filtres button');
    const cartes = document.querySelectorAll<HTMLElement>('#catalogue > [data-cat]');
    boutons.forEach((b) => b.addEventListener('click', () => {
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cartes.forEach((c) => { c.hidden = !!b.dataset.cat && c.dataset.cat !== b.dataset.cat; });
    }));
  </script>
)}

<style>
  .section--catalogue { padding-top: 32px; }
  .grille { grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .filtres { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .filtres button { min-height: 46px; padding: 0 20px; border-radius: 999px; border: 1px solid var(--bord); background: #fff; font: inherit; font-weight: 600; cursor: pointer; box-shadow: var(--ombre); transition: background .2s, color .2s; }
  .filtres button[aria-pressed='true'] { background: var(--marine); border-color: var(--marine); color: #fff; }
  .aide { margin-top: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; background: linear-gradient(120deg, var(--orange-50), #fff); border-color: #ffd9a8; }
  .aide h2 { font-size: 1.35rem; margin-bottom: .3em; }
  .aide p { margin: 0; color: var(--texte-doux); }
</style>
