---
import Base from '../layouts/Base.astro';
import BoutonWhatsApp from '../components/BoutonWhatsApp.astro';
import EntetePage from '../components/EntetePage.astro';
import Icone from '../components/Icone.astro';
import IconeWhatsApp from '../components/IconeWhatsApp.astro';
import { site } from '../lib/site';
const infos = [
  site.telephone && { icone: 'telephone', titre: 'Téléphone', html: `<a href="tel:${site.telephone.replace(/\s/g, '')}">${site.telephone}</a>` },
  site.email && { icone: 'mail', titre: 'Email', html: `<a href="mailto:${site.email}">${site.email}</a>` },
  site.horaires && { icone: 'horloge', titre: 'Horaires', html: site.horaires },
  site.adresse && { icone: 'carte', titre: 'Adresse', html: site.adresse + (site.google_maps_url ? `<br><a href="${site.google_maps_url}" target="_blank" rel="noopener">Itinéraire Google Maps</a>` : '') },
].filter(Boolean) as { icone: 'telephone' | 'mail' | 'horloge' | 'carte'; titre: string; html: string }[];
---
<Base titre="Contact" description={`Contactez ${site.nom} sur WhatsApp pour louer un véhicule au Togo.`}>
  <EntetePage surtitre="Contact" titre="Parlons de votre location" intro="Le plus rapide : WhatsApp. Indiquez le véhicule souhaité, vos dates et le lieu de prise en charge." />
  <section class="section">
    <div class="conteneur">
      <div class="contact-wa revele" data-masque-bulle>
        <span class="contact-wa__icone"><IconeWhatsApp /></span>
        <div><h2>Écrivez-nous sur WhatsApp</h2><p>Un message suffit : notre équipe vous répond avec la disponibilité et le tarif.</p></div>
        <BoutonWhatsApp libelle="Démarrer la discussion" source="contact" />
      </div>
      {infos.length > 0 && (
        <div class="grille infos">
          {infos.map((i) => <div class="carte revele"><span class="pastille"><Icone nom={i.icone} /></span><h2 class="h3">{i.titre}</h2><p set:html={i.html} /></div>)}
        </div>
      )}
    </div>
  </section>
</Base>
<style>
  .h3 { font-size: 1.15rem; }
  .contact-wa { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px; padding: 32px; border-radius: 24px; background: linear-gradient(120deg, #e9fbf0, #fff); border: 1px solid #c9f0d8; box-shadow: var(--ombre); }
  .contact-wa > div { flex: 1 1 280px; }
  .contact-wa h2 { font-size: 1.5rem; margin-bottom: .3em; }
  .contact-wa p { margin: 0; color: var(--texte-doux); }
  .contact-wa__icone { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; background: var(--wa); color: #fff; box-shadow: 0 10px 24px rgb(37 211 102 / .35); }
  .contact-wa__icone :global(svg) { width: 40px; height: 40px; }
  .infos { margin-top: 32px; }
</style>
