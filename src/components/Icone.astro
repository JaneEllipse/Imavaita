---
// Icônes au trait Tabler Icons (licence MIT, https://tabler.io/icons), en SVG inline : aucune requête.
// Usage : <Icone nom="suv" />. Tracés dans src/lib/icones.ts.
import { chemins, type NomIcone } from '../lib/icones';
interface Props { nom: NomIcone; class?: string }
const { nom, class: cls } = Astro.props;
---
<svg class:list={['ico', cls]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={chemins[nom]} />
