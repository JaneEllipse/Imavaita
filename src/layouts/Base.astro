---
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-800.css';
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo-imavaita.png';
import IconeWhatsApp from '../components/IconeWhatsApp.astro';
import BulleWhatsApp from '../components/BulleWhatsApp.astro';
import Icone from '../components/Icone.astro';
import { site, waLink, messageGeneral } from '../lib/site';

interface Props { titre: string; description: string; jsonld?: Record<string, unknown>; noindex?: boolean; vehicule?: string }
const { titre, description, jsonld, noindex = false, vehicule } = Astro.props;
const titreComplet = titre === site.nom ? `${site.nom} – ${site.slogan}` : `${titre} | ${site.nom}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const chemin = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/vehicules/', label: 'Nos véhicules' },
  { href: '/tarifs-services/', label: 'Tarifs et services' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' },
];
const actif = (href: string) => (href === '/' ? chemin === '/' : chemin.startsWith(href));
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#00306e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_TG" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="sr-only" href="#contenu">Aller au contenu</a>
    <header class="entete" data-entete>
      <div class="conteneur entete__barre">
        <a href="/" class="entete__logo" aria-label={`${site.nom}, accueil`}>
          <Image src={logo} alt={site.nom} width={170} densities={[1, 2]} loading="eager" />
        </a>
        <button type="button" class="entete__menu" aria-expanded="false" aria-controls="nav-principale" data-menu>
          <span></span><span></span><span></span><span class="sr-only">Menu</span>
        </button>
        <nav aria-label="Navigation principale" class="nav" id="nav-principale">
          <ul>
            {nav.map((l) => (
              <li><a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
          <a class="btn btn--wa nav__cta" href={waLink(messageGeneral)} target="_blank" rel="noopener" data-wa="entete">
            <IconeWhatsApp />Réserver sur WhatsApp
          </a>
        </nav>
      </div>
    </header>

    <main id="contenu"><slot /></main>

    <footer class="pied">
      <div class="conteneur pied__grille">
        <div class="pied__marque">
          <Image src={logo} alt={site.nom} width={170} densities={[1, 2]} />
          <p>{site.slogan}. Réservation simple et rapide sur WhatsApp.</p>
        </div>
        <div>
          <p class="pied__titre">Navigation</p>
          <ul class="pied__liens">{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <p class="pied__titre">Nous contacter</p>
          <ul class="pied__liens pied__contact">
            <li><a href={waLink(messageGeneral)} target="_blank" rel="noopener" data-wa="pied"><IconeWhatsApp />WhatsApp</a></li>
            {site.telephone && <li><a href={`tel:${site.telephone.replace(/\s/g, '')}`}><Icone nom="telephone" />{site.telephone}</a></li>}
            {site.email && <li><a href={`mailto:${site.email}`}><Icone nom="mail" />{site.email}</a></li>}
            {site.adresse && <li><span><Icone nom="carte" />{site.adresse}</span></li>}
            {site.horaires && <li><span><Icone nom="horloge" />{site.horaires}</span></li>}
            {site.google_maps_url && <li><a href={site.google_maps_url} target="_blank" rel="noopener"><Icone nom="carte" />Voir sur Google Maps</a></li>}
          </ul>
        </div>
      </div>
      <div class="conteneur pied__legal">
        <span>© {new Date().getFullYear()} {site.nom}</span>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
      </div>
    </footer>

    <BulleWhatsApp vehicule={vehicule} />

    <script>
      // Mesure des clics WhatsApp : n'envoie rien tant qu'aucun outil de statistiques n'est chargé.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-wa]');
        if (!a) return;
        const w = window as unknown as { plausible?: (ev: string, o?: object) => void };
        w.plausible?.('WhatsApp', { props: { source: a.dataset.wa } });
      });
      // En-tête : ombre au défilement + menu mobile
      const entete = document.querySelector<HTMLElement>('[data-entete]')!;
      const surDefilement = () => entete.classList.toggle('defile', window.scrollY > 8);
      surDefilement();
      window.addEventListener('scroll', surDefilement, { passive: true });
      const menu = document.querySelector<HTMLButtonElement>('[data-menu]')!;
      menu.addEventListener('click', () => {
        const ouvert = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(ouvert));
        entete.classList.toggle('menu-ouvert', ouvert);
      });
      // Apparition douce des blocs
      const blocs = document.querySelectorAll('.revele');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entrees) => entrees.forEach((en) => {
          if (en.isIntersecting) { en.target.classList.add('vu'); io.unobserve(en.target); }
        }), { rootMargin: '0px 0px -8% 0px' });
        blocs.forEach((b) => io.observe(b));
      } else blocs.forEach((b) => b.classList.add('vu'));
    </script>

    <style>
      .entete { position: sticky; top: 0; z-index: 40; background: rgb(255 255 255 / .92); backdrop-filter: saturate(1.4) blur(10px); transition: box-shadow .25s ease; }
      .entete.defile { box-shadow: 0 6px 24px rgb(0 27 64 / .1); }
      .entete__barre { display: flex; align-items: center; gap: 20px; min-height: 76px; }
      .entete__logo img { width: 160px; height: auto; }
      .nav { margin-left: auto; display: flex; align-items: center; gap: 18px; }
      .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
      .nav li a { position: relative; display: block; padding: 10px 12px; text-decoration: none; color: var(--texte); font-weight: 600; font-size: .96rem; white-space: nowrap; }
      .nav li a::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 3px; border-radius: 2px; background: var(--orange); transform: scaleX(0); transition: transform .2s ease; }
      .nav li a:hover::after, .nav li a[aria-current='page']::after { transform: scaleX(1); }
      .nav li a[aria-current='page'] { color: var(--marine); }
      .nav__cta { min-height: 46px; padding: .55em 1.2em; font-size: .95rem; }
      .entete__menu { display: none; }
      @media (max-width: 1000px) {
        .entete__barre { min-height: 66px; }
        .entete__logo img { width: 140px; }
        .entete__menu { display: grid; gap: 5px; margin-left: auto; width: 48px; height: 48px; padding: 13px 11px; border: 0; border-radius: 12px; background: var(--fond-doux); cursor: pointer; }
        .entete__menu span:not(.sr-only) { display: block; height: 2.5px; border-radius: 2px; background: var(--marine); transition: transform .2s, opacity .2s; }
        .menu-ouvert .entete__menu span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
        .menu-ouvert .entete__menu span:nth-child(2) { opacity: 0; }
        .menu-ouvert .entete__menu span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }
        .nav { position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 12px; padding: 12px 16px 20px; background: #fff; box-shadow: 0 16px 30px rgb(0 27 64 / .12); display: none; }
        .menu-ouvert .nav { display: flex; }
        .nav ul { flex-direction: column; }
        .nav li a { padding: 14px 8px; border-bottom: 1px solid var(--bord); font-size: 1.05rem; }
        .nav li a::after { display: none; }
        .nav li a[aria-current='page'] { color: var(--orange-texte); }
        /* Sans JavaScript, le menu reste visible */
        :global(html:not(.js)) .entete__menu { display: none; }
        :global(html:not(.js)) .nav { position: static; display: flex; box-shadow: none; }
        :global(html:not(.js)) .entete__barre { flex-wrap: wrap; }
      }
      .pied { background: radial-gradient(1200px 400px at 85% 0%, #0a3f86 0%, transparent 60%), var(--marine-900); color: #c9d6ea; padding: 48px 0 32px; }
      @media (max-width: 600px) { .pied { padding-bottom: 96px; } }
      .pied a { color: #fff; text-decoration: none; }
      .pied a:hover { color: var(--orange); }
      .pied__grille { display: grid; gap: 36px; grid-template-columns: 1.4fr 1fr 1.2fr; }
      @media (max-width: 800px) { .pied__grille { grid-template-columns: 1fr; } }
      .pied__marque img { width: 170px; border: 1px solid rgb(255 255 255 / .25); }
      .pied__marque p { margin-top: 16px; max-width: 34ch; }
      .pied__titre { font-family: var(--titre); font-weight: 600; color: #fff; margin-bottom: 12px; }
      .pied__liens { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
      .pied__contact a, .pied__contact span { display: inline-flex; align-items: center; gap: 10px; }
      .pied__contact :global(svg) { width: 20px; height: 20px; color: var(--orange); flex: none; }
      .pied__legal { display: flex; flex-wrap: wrap; gap: 8px 22px; border-top: 1px solid rgb(255 255 255 / .12); margin-top: 32px; padding-top: 18px; font-size: .9rem; }
    </style>
  </body>
</html>
