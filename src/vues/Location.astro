---
import Base from '../layouts/Base.astro';
import CarteVehicule from '../components/CarteVehicule.astro';
import BoutonWhatsApp from '../components/BoutonWhatsApp.astro';
import EntetePage from '../components/EntetePage.astro';
import Icone from '../components/Icone.astro';
import banniere from '../assets/location/changan-cs95.jpg';
import { site, getVehicules, filAriane, messages, infos } from '../lib/site';
import type { NomIcone } from '../lib/icones';
import { type Lang, t, lien } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const l = d.location;
const vehicules = await getVehicules();
const categories = [...new Set(vehicules.map((v) => v.data.categorie))];
const nomCat = (c: string) => d.carac.categorieLocation[c] ?? c;
const chemin = lien(lang, 'location');
const jsonld = [
  filAriane(Astro.site, [{ nom: l.titre, chemin }], lang),
  { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: vehicules.map((v, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(lien(lang, 'location', v.id), Astro.site).href, name: v.data.nom })) },
];
const avecFiltres = categories.length > 1;
const icone = (c: string): NomIcone => ({ 'SUV / 4x4': 'suv', Berline: 'berline', Citadine: 'berline', 'Pick-up': 'pickup', Minibus: 'minibus', Utilitaire: 'minibus' } as Record<string, NomIcone>)[c] ?? 'voiture';
const points: [NomIcone, string][] = d.accueil_.location.points.map((p, i) => [(['route', 'jauge', 'volant'] as NomIcone[])[i], p]);
---
<Base lang={lang} route="location" titre={l.titre} titreSeo={l.titreSeo} description={l.description(categories.map(nomCat).join(', '))} image={banniere} jsonld={jsonld}>
  <EntetePage lang={lang} titre={l.titre} intro={l.intro} image={banniere} fil={[{ label: l.titre }]}>
    <ul class="ep-points">{points.map(([i, p]) => <li><Icone nom={i} />{p}</li>)}</ul>
  </EntetePage>
  <section class="section section--catalogue section--pierre">
    <div class="conteneur">
      {avecFiltres && (
        <div class="onglets" role="group" aria-label={l.filtres}>
          <button type="button" aria-pressed="true" data-cat=""><Icone nom="grille" />{l.tous}</button>
          {categories.map((c) => <button type="button" aria-pressed="false" data-cat={c}><Icone nom={icone(c)} />{nomCat(c)}</button>)}
        </div>
      )}
      {vehicules.length > 0
        ? <div class="liste" id="catalogue">{vehicules.map((v, i) => <div data-cat={v.data.categorie} class="revele" style={`transition-delay:${(i % 2) * 80}ms`}><CarteVehicule lang={lang} vehicule={v} prioritaire={i < 2} ligne /></div>)}</div>
        : <p>{l.vide} <BoutonWhatsApp lang={lang} source="catalogue-vide" message={messages(lang).location} /></p>}
      <div class="aide revele">
        <span class="aide__icone"><Icone nom="voiture" /></span>
        <div><h2>{l.aide.titre}</h2><p>{l.aide.texte}</p></div>
        <BoutonWhatsApp lang={lang} libelle={l.aide.bouton} source="catalogue-aide" message={messages(lang).besoin} />
      </div>
      <p class="zones"><Icone nom="carte" />{infos(lang).zones}{site.horaires && <> · {infos(lang).horaires}</>}</p>
    </div>
  </section>
</Base>

{avecFiltres && (
  <script>
    const boutons = document.querySelectorAll<HTMLButtonElement>('.onglets button');
    const cartes = document.querySelectorAll<HTMLElement>('#catalogue > [data-cat]');
    boutons.forEach((b) => b.addEventListener('click', () => {
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cartes.forEach((c) => { c.hidden = !!b.dataset.cat && c.dataset.cat !== b.dataset.cat; c.classList.add('vu'); });
    }));
  </script>
)}

<style>
  .ep-points { display: flex; flex-wrap: wrap; gap: 10px 22px; list-style: none; padding: 0; margin: 22px 0 0; }
  .ep-points li { display: inline-flex; align-items: center; gap: 8px; font-size: .92rem; font-weight: 600; color: #fff; }
  .ep-points :global(svg) { width: 22px; height: 22px; color: #ffb347; }
  .section--catalogue { padding-top: 28px; }
  .onglets { display: flex; gap: 4px; margin: 0 0 28px; border-bottom: 1px solid var(--bord); overflow-x: auto; scrollbar-width: none; }
  .onglets button { position: relative; display: inline-flex; align-items: center; gap: 10px; flex: none; min-height: 52px; padding: 0 18px; border: 0; background: none; font: inherit; font-weight: 600; color: var(--texte-doux); cursor: pointer; white-space: nowrap; }
  .onglets button::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: -1px; height: 3px; border-radius: 2px; background: var(--orange); transform: scaleX(0); transition: transform .2s ease; }
  .onglets button:hover { color: var(--marine); }
  .onglets button[aria-pressed='true'] { color: var(--marine-900); }
  .onglets button[aria-pressed='true']::after { transform: scaleX(1); }
  .onglets :global(svg) { width: 24px; height: 24px; }
  :global(html:not(.js)) .onglets { display: none; }
  .liste { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr)); }
  @media (max-width: 699px) { .liste { grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); } }
  .aide { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding: 22px 26px; border-radius: 18px; background: var(--fond-doux); border: 1px solid var(--bord); }
  .aide > div { flex: 1 1 280px; }
  .aide__icone { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: #fff; color: var(--orange-600); box-shadow: var(--ombre); }
  .aide__icone :global(svg) { width: 28px; height: 28px; }
  .aide h2 { font-size: 1.2rem; margin-bottom: .2em; }
  .aide p { margin: 0; color: var(--texte-doux); font-size: .95rem; }
  .zones { display: flex; align-items: center; gap: 8px; margin: 20px 0 0; font-size: .88rem; color: var(--texte-doux); }
  .zones :global(svg) { width: 18px; height: 18px; flex: none; color: var(--orange-600); }
</style>
