---
import Base from '../layouts/Base.astro';
import CarteVente from '../components/CarteVente.astro';
import BlocCatalogue from '../components/BlocCatalogue.astro';
import BoutonWhatsApp from '../components/BoutonWhatsApp.astro';
import EntetePage from '../components/EntetePage.astro';
import Icone from '../components/Icone.astro';
import banniere from '../assets/accueil/starray.jpg';
import { site, getVente, marquesVente, filAriane, messages, nomVente } from '../lib/site';
import type { NomIcone } from '../lib/icones';
import { type Lang, t, lien } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const v = d.vente;
const msg = messages(lang);

const vehicules = await getVente();
const marques = marquesVente(vehicules);
const ordreCat = ['SUV', 'Berline', 'Pick-up', 'Poids lourd', 'Autre'];
const categories = ordreCat.filter((c) => vehicules.some((x) => x.data.categorie === c));
const icone = (c: string): NomIcone => ({ SUV: 'suv', Berline: 'berline', 'Pick-up': 'pickup', 'Poids lourd': 'camion' } as Record<string, NomIcone>)[c] ?? 'voiture';
const compte = (c: string) => vehicules.filter((x) => x.data.categorie === c).length;
const chemin = lien(lang, 'vente');
const jsonld = [
  filAriane(Astro.site, [{ nom: v.titre, chemin }], lang),
  { '@context': 'https://schema.org', '@type': 'ItemList', name: v.titre, numberOfItems: vehicules.length, itemListElement: vehicules.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: nomVente(x) })) },
];
---
<Base lang={lang} route="vente" titre={v.titre} titreSeo={v.titreSeo} description={v.description(vehicules.length, marques.join(', '))} image={banniere} jsonld={jsonld}>
  <EntetePage lang={lang} surtitre={d.catalogue.surtitre} titre={v.titre} intro={v.intro} image={banniere} fil={[{ label: v.titre }]}>
    {site.catalogue_pdf && (
      <div class="ep-actions">
        <a class="btn btn--orange" href={site.catalogue_pdf} target="_blank" rel="noopener" data-pdf="consulter"><Icone nom="oeil" />{d.bouton.consulterPdf}</a>
        <a class="btn btn--clair" href={site.catalogue_pdf} download data-pdf="telecharger"><Icone nom="telechargement" />{d.bouton.telechargerPdf}</a>
      </div>
    )}
  </EntetePage>

  <section class="section section--catalogue section--pierre">
    <div class="conteneur">
      {categories.length > 1 && (
        <div class="onglets" role="group" aria-label={v.filtres}>
          <button type="button" aria-pressed="true" data-cat=""><Icone nom="grille" />{v.tous}<span class="onglets__n">{vehicules.length}</span></button>
          {categories.map((c) => <button type="button" aria-pressed="false" data-cat={c}><Icone nom={icone(c)} />{d.carac.categorieVente[c]}<span class="onglets__n">{compte(c)}</span></button>)}
        </div>
      )}
      <div class="liste" id="catalogue-vente">
        {vehicules.map((x, i) => <div data-cat={x.data.categorie} class="revele" style={`transition-delay:${(i % 3) * 70}ms`}><CarteVente lang={lang} vehicule={x} prioritaire={i < 3} /></div>)}
      </div>
      <p class="mention"><Icone nom="badge" />{v.mentionPhotos}</p>

      <div class="duo duo--seul">
        <div class="aide revele">
          <span class="aide__icone"><Icone nom="suv" /></span>
          <div><h2>{v.aide.titre}</h2><p>{v.aide.texte}</p></div>
          <BoutonWhatsApp lang={lang} libelle={d.bouton.whatsapp} source="vente-aide" message={msg.achat} />
        </div>
      </div>

      <div class="bloc-pdf"><BlocCatalogue lang={lang} modeles={vehicules.length} marques={marques.length} /></div>
    </div>
  </section>
</Base>

{categories.length > 1 && (
  <script>
    const boutons = document.querySelectorAll<HTMLButtonElement>('.onglets button');
    const cartes = document.querySelectorAll<HTMLElement>('#catalogue-vente > [data-cat]');
    boutons.forEach((b) => b.addEventListener('click', () => {
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cartes.forEach((c) => { c.hidden = !!b.dataset.cat && c.dataset.cat !== b.dataset.cat; c.classList.add('vu'); });
    }));
  </script>
)}

<style>
  .ep-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 600px) { .ep-actions .btn { width: 100%; } }
  .section--catalogue { padding-top: 28px; }
  .onglets { display: flex; gap: 4px; margin: 0 0 28px; border-bottom: 1px solid var(--bord); overflow-x: auto; scrollbar-width: none; }
  .onglets button { position: relative; display: inline-flex; align-items: center; gap: 10px; flex: none; min-height: 52px; padding: 0 16px; border: 0; background: none; font: inherit; font-weight: 600; color: var(--texte-doux); cursor: pointer; white-space: nowrap; }
  .onglets button::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: -1px; height: 3px; border-radius: 2px; background: var(--orange); transform: scaleX(0); transition: transform .2s ease; }
  .onglets button:hover { color: var(--marine); }
  .onglets button[aria-pressed='true'] { color: var(--marine-900); }
  .onglets button[aria-pressed='true']::after { transform: scaleX(1); }
  .onglets :global(svg) { width: 24px; height: 24px; }
  .onglets__n { display: inline-grid; place-items: center; min-width: 24px; height: 22px; padding: 0 6px; border-radius: 999px; background: var(--fond-doux); font-size: .75rem; color: var(--marine); }
  :global(html:not(.js)) .onglets { display: none; }
  .liste { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  @media (max-width: 560px) { .liste { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }
  .mention { display: flex; align-items: center; gap: 8px; margin: 22px 0 0; font-size: .82rem; color: var(--texte-doux); }
  .mention :global(svg) { width: 18px; height: 18px; flex: none; }
  .duo { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 40px; }
  @media (max-width: 900px) { .duo { grid-template-columns: minmax(0, 1fr); } }
  .duo--seul { grid-template-columns: minmax(0, 1fr); }
  .duo--seul .aide :global(.btn) { width: auto; }
  @media (max-width: 600px) { .duo--seul .aide :global(.btn) { width: 100%; } }
  .aide { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; padding: 22px 24px; border-radius: 18px; background: #fff; border: 1px solid var(--bord); }
  .aide > div { flex: 1 1 220px; }
  .aide :global(.btn) { width: 100%; }
  .aide__icone { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--orange-50); color: var(--orange-600); }
  .aide__icone :global(svg) { width: 28px; height: 28px; }
  .aide h2 { font-size: 1.15rem; margin-bottom: .2em; }
  .aide p { margin: 0; color: var(--texte-doux); font-size: .93rem; }
  .bloc-pdf { margin-top: 40px; }
</style>
